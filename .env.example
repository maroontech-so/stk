# ==========================================
# PalPluss API Configuration
# ==========================================

# Your PalPluss API Key (pk_live_... or pk_test_...)
PALPLUSS_API_KEY=your_palpluss_api_key_here

# (Optional) Specific Channel ID (Paybill or Till). Leave blank to use account default.
PALPLUSS_CHANNEL_ID=

# Server Port
PORT=3000

# (Optional) Public Callback URL for PalPluss Webhooks
# Example with ngrok: https://your-ngrok-subdomain.ngrok-free.app/api/callback
CALLBACK_URL=

# Optional shared secret for authenticating PalPluss callbacks
CALLBACK_SECRET=

# SQLite database path (optional; defaults to data/lycash.db)
DATABASE_PATH=data/lycash.db
